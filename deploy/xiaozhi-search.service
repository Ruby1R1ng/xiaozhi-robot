[Unit]
Description=Xiaozhi Tavily MCP search bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/opt/xiaozhi-search
EnvironmentFile=/etc/xiaozhi-search.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TAVILY_SEARCH_DEPTH=basic
Environment=TAVILY_MAX_RESULTS=3
Environment=TAVILY_MONTHLY_CREDIT_BUDGET=900
Environment=TAVILY_CACHE_TTL_SECONDS=1800
Environment=TAVILY_USAGE_DB=/var/lib/xiaozhi-search/usage.sqlite3
Environment=SILICONFLOW_MODEL=zai-org/GLM-5.2
Environment=ZHIPU_MODEL=glm-5.1
Environment=PRIMARY_PIPELINE_TIMEOUT_SECONDS=8
Environment=BACKUP_PIPELINE_TIMEOUT_SECONDS=12
Environment=SILICONFLOW_MAX_TOKENS=450
Environment=SILICONFLOW_TIMEOUT_SECONDS=22
Environment=SILICONFLOW_THINKING_BUDGET=128
Environment=SUMMARY_SOURCE_CHARS=500
Environment=KNOWLEDGE_DB_PATH=/opt/xiaozhi-search/data/guolei/knowledge.sqlite3
Environment=KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-m3
Environment=KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=5
ExecStart=/opt/xiaozhi-search/.venv/bin/python /opt/xiaozhi-search/mcp_pipe.py /opt/xiaozhi-search/web_search.py
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
StateDirectory=xiaozhi-search
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xiaozhi-search

[Install]
WantedBy=multi-user.target
