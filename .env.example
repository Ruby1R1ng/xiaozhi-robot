# Do not commit or share the real values.
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=xxxxxxx
TAVILY_API_KEY=xxxxxxx
SILICONFLOW_API_KEY=xxxxxxx

# SiliconFlow summary model defaults.
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Pro/zai-org/GLM-5.1
SILICONFLOW_MAX_TOKENS=450
SILICONFLOW_TIMEOUT_SECONDS=22
SILICONFLOW_THINKING_BUDGET=128
SUMMARY_SOURCE_CHARS=500

# Private Guo Lei paper knowledge base.
KNOWLEDGE_DB_PATH=/opt/xiaozhi-search/data/guolei/knowledge.sqlite3
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-m3
KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=5

# Free-tier protection defaults.
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=10
TAVILY_MONTHLY_CREDIT_BUDGET=900
TAVILY_CACHE_TTL_SECONDS=1800
